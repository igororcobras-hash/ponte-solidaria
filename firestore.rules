rules_version = '2';
// Regras de segurança do banco (Firestore) — Ponte Solidária
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function profileVerified(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data.status == 'verified';
    }

    // Moderadores: só são criados manualmente no Console do Firebase
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // Contas
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && request.resource.data.role in ['donor', 'beneficiary'];
      allow update: if isMe(uid) && request.resource.data.role in ['donor', 'beneficiary'];
      allow delete: if false;
    }

    // Perfis de quem precisa de ajuda
    match /profiles/{uid} {
      allow read: if resource.data.status == 'verified' || isMe(uid) || isAdmin();

      // a própria pessoa cria o perfil, sempre como "pendente"
      allow create: if isMe(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.raised == 0
        && request.resource.data.donorsCount == 0;

      // a pessoa edita o perfil, mas não pode se autoaprovar
      allow update: if (isMe(uid) && request.resource.data.status == resource.data.status)
        || isAdmin();

      allow delete: if isAdmin();

      // Comprovações: públicas, ou só para quem está logado
      match /proofs/{proofId} {
        allow read: if isMe(uid) || isAdmin()
          || (profileVerified(uid) && (resource.data.visibility == 'public' || signedIn()));
        allow create, delete: if isMe(uid);
        allow update: if false;
      }

      // Linha do tempo
      match /timeline/{entryId} {
        allow read: if isMe(uid) || isAdmin() || profileVerified(uid);
        allow create: if isMe(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // Doações registradas
    match /donations/{id} {
      allow read: if signedIn() && (resource.data.donorUid == request.auth.uid
        || resource.data.beneficiaryUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.donorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      // só quem recebeu confirma
      allow update: if signedIn()
        && resource.data.beneficiaryUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.amount == resource.data.amount;
      allow delete: if isAdmin();
    }
  }
}
